meta {
  name: Control Multiple Relays
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/wlte/v1/devices/{{deviceId}}/relays/commands
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  Idempotency-Key: guide-multi-{{$randomInt}}
}

body:json {
  {
    "relays": [
      { "index": 1, "action": "ON" },
      { "index": 2, "action": "OFF" }
    ]
  }
}

script:post-response {
  if (res.status === 202 && res.body.data && res.body.data.command) {
    bru.setEnvVar("commandId", res.body.data.command.id);
  }
}

tests {
  test("accepted or known non-fatal code", function() {
    if (res.status === 202) {
      expect(res.body.code).to.equal("COMMAND_ACCEPTED");
      expect(res.body.data.command.operation).to.equal("device.relay.set");
      expect(res.body.data.command.params.relays).to.have.length(2);
    } else {
      const known = ["INVALID_REQUEST", "DEVICE_OFFLINE", "DEVICE_NOT_FOUND", "RATE_LIMITED", "COMMAND_REJECTED"];
      expect(known).to.include(res.body.code);
    }
  });
}
