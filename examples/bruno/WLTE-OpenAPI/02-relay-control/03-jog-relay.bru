meta {
  name: Jog Relay
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/wlte/v1/devices/{{deviceId}}/relays/commands
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  Idempotency-Key: guide-jog-{{$randomInt}}
}

body:json {
  {
    "relays": [
      { "index": {{relayIndex}}, "action": "JOG" }
    ]
  }
}

script:post-response {
  if (res.status === 202 && res.body.data && res.body.data.command) {
    bru.setEnvVar("commandId", res.body.data.command.id);
  }
}

tests {
  test("accepted or known non-fatal code", function() {
    if (res.status === 202) {
      expect(res.body.code).to.equal("COMMAND_ACCEPTED");
      expect(res.body.data.command.id).to.be.a("string").and.not.empty;
      expect(res.body.data.command.operation).to.equal("device.relay.set");
      expect(res.body.data.command.params.relays[0].action).to.equal("JOG");
    } else {
      const known = ["DEVICE_OFFLINE", "DEVICE_NOT_FOUND", "RATE_LIMITED", "COMMAND_REJECTED"];
      expect(known).to.include(res.body.code);
    }
  });
}
