meta {
  name: Set RS485 Baud Rate
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/wlte/v1/devices/{{rs485DeviceId}}/rs485/baud-rate
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  Idempotency-Key: guide-rs485-baud-{{$randomInt}}
}

body:json {
  {
    "baudRate": {{rs485BaudRate}}
  }
}

script:post-response {
  if (res.status === 202 && res.body.data && res.body.data.command) {
    bru.setEnvVar("commandId", res.body.data.command.id);
  }
}

tests {
  test("accepted or known non-fatal code", function() {
    if (res.status === 202) {
      expect(res.body.code).to.equal("COMMAND_ACCEPTED");
      expect(res.body.data.command.id).to.be.a("string").and.not.empty;
      expect(res.body.data.command.deviceId).to.equal(bru.getEnvVar("rs485DeviceId"));
      expect(res.body.data.command.operation).to.equal("device.rs485.baudRate.set");
      if (res.body.data.command.result !== undefined) {
        expect(res.body.data.command.result.baudRate).to.be.a("number");
      }
    } else {
      const known = ["AUTH_SCOPE_DENIED", "DEVICE_OFFLINE", "DEVICE_NOT_FOUND", "RATE_LIMITED", "COMMAND_REJECTED", "GATEWAY_UNAVAILABLE"];
      expect(known).to.include(res.body.code);
    }
  });
}
